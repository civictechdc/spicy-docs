{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spicy-docs:schema:document-capture:1.0:profile:senate-expenditures-pdf",
  "title": "DocumentCapture profile: senate-expenditures-pdf v1",
  "description": "Selected Senate expenditure PDF pages: extracted lines and ruled table observations. Exact cell text is retained separately from reconciled stream spans; unresolved cells carry an issue. No payment-line split, header inference, or merged-cell inference.",
  "x-parent": {
    "$id": "https://rulespec.org/schemas/releases/document-capture-v1.schema.json",
    "sha256": "a090fbc8baf6ae55c80a29ad70fc9d411b495ede26443dd0c4f125dd4184689e"
  },
  "allOf": [
    {
      "$ref": "https://rulespec.org/schemas/releases/document-capture-v1.schema.json"
    },
    {
      "properties": {
        "profile": {
          "properties": {
            "name": {
              "const": "senate-expenditures-pdf"
            },
            "version": {
              "const": "1"
            },
            "ext": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "packageId",
                "fileName",
                "pagesRead",
                "pageCount",
                "lineConverterSha256",
                "sourceRecords",
                "renditionReason",
                "govinfoIdentity"
              ],
              "properties": {
                "packageId": {
                  "type": "string"
                },
                "fileName": {
                  "type": "string"
                },
                "pagesRead": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "pageCount": {
                  "type": "integer"
                },
                "lineConverterSha256": {
                  "type": "string"
                },
                "sourceRecords": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role",
                      "sha256",
                      "byteSize",
                      "mediaType"
                    ],
                    "properties": {
                      "role": {
                        "enum": [
                          "acquisition",
                          "mods"
                        ]
                      },
                      "path": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "byteSize": {
                        "type": "integer"
                      },
                      "mediaType": {
                        "type": "string"
                      },
                      "retrievedAt": {
                        "type": "string"
                      },
                      "receipt": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "path",
                          "sha256",
                          "selector"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "selector": {
                            "type": "string"
                          }
                        }
                      },
                      "packageId": {
                        "type": "string"
                      },
                      "granuleId": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "identityPaths": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "renditionReason": {
                  "type": "string"
                },
                "govinfoIdentity": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "packageId",
                    "granuleId",
                    "basis"
                  ],
                  "properties": {
                    "packageId": {
                      "type": "string"
                    },
                    "granuleId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "basis": {
                      "type": "string"
                    }
                  }
                },
                "derivedFrom": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url",
                    "path",
                    "sha256",
                    "byteSize",
                    "mediaType",
                    "retrievedAt",
                    "sourcePage",
                    "method"
                  ],
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "byteSize": {
                      "type": "integer"
                    },
                    "mediaType": {
                      "const": "application/pdf"
                    },
                    "retrievedAt": {
                      "type": "string"
                    },
                    "sourcePage": {
                      "type": "integer"
                    },
                    "method": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "nodes": {
          "items": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "type": "string",
                      "pattern": "^senate-expenditures-pdf:"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "kind": {
                      "enum": []
                    }
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "not": {
                      "pattern": "^(?!senate-expenditures-pdf:)[a-z][a-z0-9-]*:"
                    }
                  }
                }
              },
              {
                "properties": {
                  "ext": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "tableOrdinal": {
                        "type": "integer"
                      },
                      "rowCount": {
                        "type": "integer"
                      },
                      "columnCount": {
                        "type": "integer"
                      },
                      "observedText": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Verbatim TableObservation cell text, including text absent from the line stream. Null means a box without text; absent cells have no node."
                      },
                      "pageTextSha256": {
                        "type": "string",
                        "description": "Digest of PageResult.text before line assembly; joins the Senate ruled-row identity, never a capture-stream offset."
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
