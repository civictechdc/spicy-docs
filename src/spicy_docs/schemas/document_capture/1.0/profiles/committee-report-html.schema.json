{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spicy-docs:schema:document-capture:1.0:profile:committee-report-html",
  "title": "DocumentCapture profile: committee-report-html v1",
  "description": "A GovInfo committee-report HTML body: one preformatted run split into blank-line blocks. A block is a ruled column-aligned table, a centred-capitals or record-vote heading, or a paragraph, page marker, banner or rule. Block structure is markup-derived, not the publisher's, and every rule that placed a block names itself in the node's decision.",
  "x-parent": {
    "$id": "https://rulespec.org/schemas/releases/document-capture-v1.schema.json",
    "sha256": "a090fbc8baf6ae55c80a29ad70fc9d411b495ede26443dd0c4f125dd4184689e"
  },
  "allOf": [
    {
      "$ref": "https://rulespec.org/schemas/releases/document-capture-v1.schema.json"
    },
    {
      "properties": {
        "profile": {
          "properties": {
            "name": {
              "const": "committee-report-html"
            },
            "version": {
              "const": "1"
            },
            "ext": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "blockRule",
                "packageId",
                "sourceRecords",
                "renditionReason",
                "govinfoIdentity"
              ],
              "properties": {
                "packageId": {
                  "type": "string"
                },
                "blockRule": {
                  "const": "blank-line"
                },
                "sourceRecords": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role",
                      "sha256",
                      "byteSize",
                      "mediaType"
                    ],
                    "properties": {
                      "role": {
                        "enum": [
                          "acquisition",
                          "mods"
                        ]
                      },
                      "path": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "byteSize": {
                        "type": "integer"
                      },
                      "mediaType": {
                        "type": "string"
                      },
                      "retrievedAt": {
                        "type": "string"
                      },
                      "receipt": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "path",
                          "sha256",
                          "selector"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "selector": {
                            "type": "string"
                          }
                        }
                      },
                      "packageId": {
                        "type": "string"
                      },
                      "granuleId": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "identityPaths": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "sourceFields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "name",
                            "value",
                            "attributes",
                            "path"
                          ],
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "value": {
                              "type": "string"
                            },
                            "attributes": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "string"
                              }
                            },
                            "path": {
                              "type": "array",
                              "items": {
                                "type": "integer"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "renditionReason": {
                  "type": "string"
                },
                "govinfoIdentity": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "packageId",
                    "granuleId",
                    "basis"
                  ],
                  "properties": {
                    "packageId": {
                      "type": "string"
                    },
                    "granuleId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "basis": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "nodes": {
          "items": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "type": "string",
                      "pattern": "^committee-report-html:"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "committee-report-html:banner",
                        "committee-report-html:heading",
                        "committee-report-html:preformatted",
                        "committee-report-html:rule"
                      ]
                    }
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "not": {
                      "pattern": "^(?!committee-report-html:)[a-z][a-z0-9-]*:"
                    }
                  }
                }
              },
              {
                "properties": {
                  "ext": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {}
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
