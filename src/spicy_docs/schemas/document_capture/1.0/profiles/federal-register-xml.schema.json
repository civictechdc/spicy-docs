{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spicy-docs:schema:document-capture:1.0:profile:federal-register-xml",
  "title": "DocumentCapture profile: federal-register-xml v1",
  "description": "A Federal Register document XML (RULE, PRORULE, NOTICE, PRESDOCU). Preamble blocks are sections with a HED heading; GPOTABLE rows and cells carry cell geometry; FTNT is a footnote; PRTPAGE is a page number.",
  "x-parent": {
    "$id": "https://rulespec.org/schemas/releases/document-capture-v1.schema.json",
    "sha256": "90515b951c60d5f4c179abd4de6431993839101c2f435c1e9aa1e612e875b4fb"
  },
  "allOf": [
    {
      "$ref": "https://rulespec.org/schemas/releases/document-capture-v1.schema.json"
    },
    {
      "properties": {
        "profile": {
          "properties": {
            "name": {
              "const": "federal-register-xml"
            },
            "version": {
              "const": "1"
            },
            "ext": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "agencies",
                "citation",
                "documentJsonSha256",
                "documentNumber",
                "endPage",
                "publicationDate",
                "startPage",
                "type"
              ],
              "properties": {
                "documentNumber": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "publicationDate": {
                  "type": "string"
                },
                "citation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "startPage": {
                  "type": "integer"
                },
                "endPage": {
                  "type": "integer"
                },
                "agencies": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "documentJsonSha256": {
                  "type": "string"
                }
              }
            }
          }
        },
        "nodes": {
          "items": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "type": "string",
                      "pattern": "^federal-register-xml:"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "federal-register-xml:listOfSubjects",
                        "federal-register-xml:regText"
                      ]
                    }
                  }
                }
              },
              {
                "properties": {
                  "ext": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [],
                    "properties": {
                      "headLevel": {
                        "type": "string"
                      },
                      "indent": {
                        "type": "string"
                      },
                      "cols": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "cdef": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
