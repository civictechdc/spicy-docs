{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulespec.org/schemas/releases/document-capture-profile-v1.schema.json",
  "title": "DocumentCapture v1 family profile",
  "description": "The shape a family profile must have to compose the DocumentCapture v1 parent, stated as data rather than as a checker. A profile is exactly allOf: [{$ref: parent}, own narrowing]; the narrowing touches only profile.name, profile.version, profile.ext, node kind inside the profile's own namespace, and node ext. Every object here is closed, so a keyword this schema does not name -- else, not, required, minItems, additionalProperties, a second $ref -- is a refusal rather than an unnoticed tightening. Two bindings this schema cannot state, because JSON Schema cannot read one part of a document from another, are checked beside it: the x-parent pin equals the parent's bytes, and every namespaced kind and refusal pattern carries the profile's own name. See spec/document-capture.md section 4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "title",
    "description",
    "x-parent",
    "allOf"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "x-parent": {
      "description": "The parent's $id and the sha256 of the parent bytes this profile was written against. The digest is compared to the parent beside this schema; a moved parent moves every profile in the same change.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$id",
        "sha256"
      ],
      "properties": {
        "$id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "allOf": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "description": "The parent, referenced and never restated.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$ref"
          ],
          "properties": {
            "$ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "description": "The family's own narrowing: properties, and nothing else.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "properties"
          ],
          "properties": {
            "properties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile",
                "nodes"
              ],
              "properties": {
                "profile": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "properties"
                  ],
                  "properties": {
                    "properties": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "version",
                        "ext"
                      ],
                      "properties": {
                        "name": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "const"
                          ],
                          "properties": {
                            "const": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9-]*$"
                            }
                          }
                        },
                        "version": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "const"
                          ],
                          "properties": {
                            "const": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "ext": {
                          "$ref": "#/$defs/ClosedObjectSchema"
                        }
                      }
                    }
                  }
                },
                "nodes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "allOf"
                      ],
                      "properties": {
                        "allOf": {
                          "description": "Exactly three clauses, in order: the family's kinds, the refusal of foreign namespaces, and the family's per-node extension block. A profile with no family kind of its own still carries all three, with an empty enum.",
                          "type": "array",
                          "minItems": 3,
                          "maxItems": 3,
                          "prefixItems": [
                            {
                              "$ref": "#/$defs/KindClause"
                            },
                            {
                              "$ref": "#/$defs/ForeignNamespaceClause"
                            },
                            {
                              "$ref": "#/$defs/ExtClause"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "KindClause": {
      "description": "If the node's kind is in this profile's namespace, it is one of the kinds the profile enumerates. The pattern and every enum item must carry the profile's own name; that binding is checked beside this schema.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "if",
        "then"
      ],
      "properties": {
        "if": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "properties",
            "required"
          ],
          "properties": {
            "properties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "pattern"
                  ],
                  "properties": {
                    "type": {
                      "const": "string"
                    },
                    "pattern": {
                      "type": "string",
                      "pattern": "^\\^[a-z][a-z0-9-]*:$"
                    }
                  }
                }
              }
            },
            "required": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "const": "kind"
              }
            }
          }
        },
        "then": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "properties"
          ],
          "properties": {
            "properties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enum"
                  ],
                  "properties": {
                    "enum": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*:[A-Za-z][A-Za-z0-9-]*$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "ForeignNamespaceClause": {
      "description": "A namespaced kind whose prefix is not this profile's is refused here, not only by the invariant validator, so a capture carrying another family's kind fails schema validation. The pattern's negative lookahead must name this profile; that binding is checked beside this schema.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "properties"
      ],
      "properties": {
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "not"
              ],
              "properties": {
                "not": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pattern"
                  ],
                  "properties": {
                    "pattern": {
                      "type": "string",
                      "pattern": "^\\^\\(\\?![a-z][a-z0-9-]*:\\)\\[a-z\\]\\[a-z0-9-\\]\\*:$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "ExtClause": {
      "description": "The family's closed per-node extension block, and nothing else about a node.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "properties"
      ],
      "properties": {
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ext"
          ],
          "properties": {
            "ext": {
              "$ref": "#/$defs/ClosedObjectSchema"
            }
          }
        }
      }
    },
    "ClosedObjectSchema": {
      "description": "An extension block: an object schema that names every field it allows and refuses the rest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "additionalProperties",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "additionalProperties": {
          "const": false
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ValueSchema"
          }
        }
      }
    },
    "ValueSchema": {
      "description": "A field inside an extension block. The vocabulary is deliberately small: enough to say what a value is, never enough to reach a parent field.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "oneOf": [
            {
              "$ref": "#/$defs/SimpleType"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/SimpleType"
              }
            }
          ]
        },
        "const": true,
        "enum": {
          "type": "array",
          "uniqueItems": true
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ValueSchema"
            }
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ValueSchema"
          }
        },
        "items": {
          "$ref": "#/$defs/ValueSchema"
        }
      }
    },
    "SimpleType": {
      "enum": [
        "object",
        "array",
        "string",
        "integer",
        "number",
        "boolean",
        "null"
      ]
    }
  }
}
