#!/usr/bin/env bash
# The same locked, offline-by-default checks used in CI.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

uv sync --frozen --all-extras
uv run --frozen ruff check .
uv run --frozen ruff format --check .
uv run --frozen python scripts/generate_filemap.py --check
uv run --frozen pytest -q
